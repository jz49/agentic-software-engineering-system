    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn verify*)",
      "Bash(mvn -q *)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm ci*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node --test*)",
      "mcp__semgrep__*",
      "mcp__context7__*"
